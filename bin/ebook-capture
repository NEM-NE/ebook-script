#!/usr/bin/env bash
# ebook-capture — CLI entry point.
#
# Flag mode (non-interactive when all required flags are given):
#   bin/ebook-capture --book "책이름" --pages 120 --region "100 100 800 600" --app 1
#
# Interactive mode: run without flags; missing parameters are prompted.
# run-script.sh remains as a backward-compatible wrapper.

set -o errexit
set -o nounset
set -o pipefail

if [[ "${DEBUG:-}" == "true" ]]; then
  set -x
fi

# shellcheck source=../lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/common.sh"
# shellcheck source=../lib/regions.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/regions.sh"
# shellcheck source=../lib/input.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/input.sh"
# shellcheck source=../lib/capture.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/capture.sh"

usage() {
  cat <<'EOF'
ebook-capture — 교보문고 전자도서관 Ebook 캡처 스크립트

Usage:
  ebook-capture --book NAME --pages N --region "x y w h" --app APP

Options:
  --book NAME          책 이름 (PDF 파일명으로 사용)
  --pages N            총 페이지 수. auto 로 주면 끝까지 (마지막 페이지 자동 감지)
  --region SPEC        캡처 영역: "x y w h" 좌표 | auto (전경 창에서 자동) |
                       저장한 프리셋 이름
  --region-margin N    auto 영역의 창 가장자리 여백 px (기본 10)
  --app APP            1 | library (교보도서관) 또는 2 | ebook (교보eBook)
  --save-region NAME   이번 실행에 사용된 영역을 프리셋으로 저장
  --list-regions       저장된 영역 프리셋 목록 출력
  --resume             중단됐던 캡처를 이어서 (마지막 페이지 다음부터, 저장된
                       영역 자동 재사용)
  --resize N           후처리: PNG를 N%로 축소 (예: --resize 50)
  --gray               후처리: 흑백 변환 (파일 크기 절감)
  -h, --help           이 도움말

지정되지 않은 옵션은 대화형으로 물어봅니다. 플래그 없이 실행하면
기존 run-script.sh와 동일한 대화형 모드로 동작합니다.
페이지 넘김은 프레임 비교로 적응형 진행됩니다.

Env:
  EBOOK_APP_NAME  앱 이름 직접 오버라이드 (테스트/기타 리더용)
  DEBUG=true      실행 명령 추적 출력
EOF
}

BOOK="" PAGES="" REGION="" APP_FLAG="" APP_NAME=""
REGION_MARGIN=10 SAVE_REGION="" LIST_REGIONS=0
RESUME=0 RESIZE="" GRAY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --book)          BOOK="$2"; shift 2 ;;
    --pages)         PAGES="$2"; shift 2 ;;
    --region)        REGION="$2"; shift 2 ;;
    --region-margin) REGION_MARGIN="$2"; shift 2 ;;
    --app)           APP_FLAG="$2"; shift 2 ;;
    --save-region)   SAVE_REGION="$2"; shift 2 ;;
    --list-regions)  LIST_REGIONS=1; shift ;;
    --resume)        RESUME=1; shift ;;
    --resize)        RESIZE="$2"; [[ "$RESIZE" =~ ^[0-9]+%?$ ]] || die "--resize expects N or N%"; [[ "$RESIZE" == *% ]] || RESIZE="$RESIZE%"; shift 2 ;;
    --gray)          GRAY=1; shift ;;
    -h|--help)       usage; exit 0 ;;
    *)               echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ "$LIST_REGIONS" == "1" ]]; then
  list_region_presets
  exit 0
fi

check_environment

# "auto" pages → capture until the end-of-book auto-stop
if [[ "$PAGES" == "auto" || "$PAGES" == "0" ]]; then
  PAGES=0
fi

# Validate flag values up front (fail fast, before any prompts)
[[ -z "$BOOK"   ]] || validate_book_name "$BOOK"
[[ -z "$PAGES"  ]] || validate_pages "$PAGES"
[[ -z "$REGION" ]] || true
if [[ -n "$APP_FLAG" ]]; then
  APP_NAME="$(resolve_app_name "$APP_FLAG")" || die "unknown --app value: $APP_FLAG (use 1|2|library|ebook)"
fi

# Resolve the region: literal coords | auto (frontmost window) | preset name
if [[ -n "$REGION" ]]; then
  if [[ "$REGION" == "auto" ]]; then
    REGION="$(auto_region "$REGION_MARGIN")"
  elif ! validate_region_quiet "$REGION"; then
    REGION="$(load_region_preset "$REGION")"
  fi
fi

# Prompt for whatever is missing (interactive fallback).
# On --resume, pre-fill region/app from the unfinished run's stored values.
[[ -n "$BOOK" ]] || prompt_book
if [[ "$RESUME" == "1" ]]; then
  state_file="$HOME/Desktop/$PREFIX$BOOK/region.txt"
  if [[ -f "$state_file" ]]; then
    if [[ -z "$REGION" ]]; then REGION="$(sed -n 1p "$state_file")"; fi
    stored_app="$(sed -n 2p "$state_file")"
    if [[ -z "$APP_NAME" && -n "$stored_app" ]]; then APP_NAME="$stored_app"; fi
  fi
fi
[[ -n "$PAGES" ]] || prompt_pages
[[ -n "$REGION" ]] || prompt_region
[[ -n "$APP_NAME" ]] || prompt_app

# Save the region actually used as a preset, if requested
if [[ -n "$SAVE_REGION" ]]; then
  save_region_preset "$SAVE_REGION" "$REGION"
fi

# Test hook: override the reader app (used by test/smoke.sh to drive Preview)
APP_NAME="${EBOOK_APP_NAME:-$APP_NAME}"

run_capture
